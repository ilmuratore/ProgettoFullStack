                "{{cliente_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Risposta con dati cliente', () => {",
                  "    const d = pm.response.json().data;",
                  "    pm.expect(d.id.toString()).to.eql(pm.collectionVariables.get('cliente_id').toString());",
                  "    pm.expect(d).to.have.property('ragione_sociale');",
                  "    pm.expect(d).to.have.property('piva_cf');",
                  "    pm.expect(d).to.have.property('source');",
                  "    pm.expect(d.source).to.eql('manual');",
                  "});"
                ]
              }
            }
          ]
