          "event": [
            {
              "listen": "prerequest",
              "script": {
                "id": "54e911d7-8c9c-4bee-ab06-4f9d8bf9d362",
                "exec": [
                  "var run = Date.now().toString();",
                  "pm.collectionVariables.set('runId', run);",
                  "pm.collectionVariables.set('resp_acquisti_email',    'test.m04.racq.'  + run + '@logichain.it');",
                  "pm.collectionVariables.set('resp_magazzino_email',   'test.m04.rmag.'  + run + '@logichain.it');",
                  "pm.collectionVariables.set('operatore_email',        'test.m04.oper.'  + run + '@logichain.it');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "id": "95055b2a-eb56-4f7a-8b63-4e57f51a8da8",
                "exec": [
                  "var b = pm.response.json();",
                  "pm.test('Setup: Login Admin -> 200', () => pm.response.to.have.status(200));",
                  "if (b.data && b.data.token) { pm.collectionVariables.set('token_admin', b.data.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
