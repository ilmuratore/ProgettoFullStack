      "name": "Ubicazioni — 12 test",
      "item": [
        {
          "name": "01 POST /magazzini/:magId/ubicazioni — crea valida",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json();",
                  "pm.test('status success', () => pm.expect(d.status).to.eql('success'));",
                  "pm.test('codice_composto presente', () => pm.expect(d.data).to.have.property('codice_composto'));",
