        {
          "id": "79f268bf-6869-49b5-928e-52403e1a67b9",
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "id": "5e65c927-2faf-466a-8b06-4931211b54d3",
                "exec": [
                  "var run = Date.now().toString();",
                  "pm.collectionVariables.set('runId', run);",
                  "pm.collectionVariables.set('resp_magazzino_email', 'test.m06.rmag.' + run + '@logichain.it');",
                  "pm.collectionVariables.set('operatore_email',      'test.m06.oper.' + run + '@logichain.it');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "id": "d2cdf6f1-b0f5-400d-9610-fc642a59a592",
                "exec": [
                  "var b = pm.response.json();",
                  "pm.test('Setup: Login Admin -> 200', () => pm.response.to.have.status(200));",
                  "if (b.data && b.data.token) { pm.collectionVariables.set('token_admin', b.data.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
