                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('stato BOZZA', () => pm.expect(d.data.stato).to.eql('BOZZA'));",
                  "pm.test('importo_totale = 1250', () => pm.expect(Number(d.data.importo_totale)).to.eql(1250));",
