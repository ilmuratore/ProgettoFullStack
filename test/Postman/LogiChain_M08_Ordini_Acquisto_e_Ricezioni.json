                  "pm.test('array', () => pm.expect(d.data).to.be.an('array'));",
                  "pm.test('contiene ordine creato', () => pm.expect(d.data.some(o => o.id === parseInt(pm.collectionVariables.get('ordine_id')))).to.be.true);"
                ]
