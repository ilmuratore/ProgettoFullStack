          "name": "01 - Disponibilita iniziale (100/0/100)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/ordini/disponibilita/{{prodotto_id}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j=pm.response.json();",
                  "pm.test(\"200\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"totale 100\",()=>pm.expect(j.data.totale).to.eql(100));",
                  "pm.test(\"impegnato 0\",()=>pm.expect(j.data.impegnato).to.eql(0));",
                  "pm.test(\"disponibile 100\",()=>pm.expect(j.data.disponibile).to.eql(100));",
                  ""
                ]
              }
            }
          ]
        },
