            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Dettaglio ordine OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PDF ordine acquisto",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/ordini-acquisto/{{ordine_acquisto_id}}/pdf",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "ordini-acquisto",
                "{{ordine_acquisto_id}}",
                "pdf"
              ]
            },
            "description": "Verifica che il PDF dell'ordine venga generato correttamente. Questo è lo stesso PDF che viene allegato all'email."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('PDF generato', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Invio email ordine acquisto",
      "item": [
        {
          "name": "Invia email senza contabile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/ordini-acquisto/{{ordine_acquisto_id}}/invia-email",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "ordini-acquisto",
                "{{ordine_acquisto_id}}",
                "invia-email"
              ]
            },
            "description": "Invia email allegando solo il PDF ordine generato dal backend. Non impostare manualmente Content-Type: Postman gestisce il boundary multipart.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "to",
                  "value": "{{email_to}}",
                  "type": "text",
                  "description": "Opzionale: se lo lasci vuoto, il backend usa fornitori.email"
                },
                {
                  "key": "cc",
                  "value": "{{email_cc}}",
                  "type": "text",
                  "disabled": true
                },
                {
                  "key": "bcc",
                  "value": "{{email_bcc}}",
                  "type": "text",
                  "disabled": true
                },
                {
                  "key": "subject",
                  "value": "{{email_subject}}",
                  "type": "text"
                },
                {
                  "key": "message",
                  "value": "{{email_message}}",
                  "type": "text"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invio email OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Response success', function () {",
                  "  pm.expect(json.status).to.eql('success');",
                  "  pm.expect(json.data).to.have.property('email_log');",
                  "});",
                  "",
                  "if (json?.data?.email_log?.id) {",
                  "  console.log('Email log id:', json.data.email_log.id);",
                  "}",
                  "if (json?.data?.message_id) {",
                  "  console.log('Provider message id:', json.data.message_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Invia email con contabile PDF/immagine",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
