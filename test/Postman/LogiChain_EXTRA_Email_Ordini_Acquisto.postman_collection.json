{
  "info": {
    "_postman_id": "d7f0025f-e2ac-47c6-95c3-2c037b0e3c37",
    "name": "LogiChain V2 — Extra Email Ordine Acquisto",
    "description": "Collection per testare l'invio email degli ordini di acquisto con PDF ordine generato dal backend e contabile opzionale in allegato.\n\nFlusso consigliato:\n1. Compila email/password nelle variabili della collection.\n2. Esegui Login: il token viene salvato automaticamente.\n3. Esegui Lista ordini acquisto oppure imposta manualmente ordine_acquisto_id.\n4. Esegui PDF ordine per verificare che il PDF venga generato.\n5. Esegui Invia email senza contabile oppure Invia email con contabile.\n6. Esegui Email log ordine per verificare il log dell'invio.\n\nAllineata allo standard delle milestone: base_url=http://localhost:3000, admin_email/admin_password, token_admin e URL /api/v1/... . Questa collection resta un flusso operativo/manuale: usa ordine_acquisto_id esistente oppure impostalo dopo aver eseguito M08.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "admin_email",
      "value": "admin@logichain.it",
      "type": "string"
    },
    {
      "key": "admin_password",
      "value": "Admin123!",
      "type": "string"
    },
    {
      "key": "token_admin",
      "value": "",
      "type": "string"
    },
    {
      "key": "ordine_acquisto_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "email_to",
      "value": "fornitore@example.com",
      "type": "string"
    },
    {
      "key": "email_cc",
      "value": "",
      "type": "string"
    },
    {
      "key": "email_bcc",
      "value": "",
      "type": "string"
    },
    {
      "key": "email_subject",
      "value": "Ordine di acquisto PO-{{ordine_acquisto_id}}",
      "type": "string"
    },
    {
      "key": "email_message",
      "value": "Buongiorno,\\n\\nin allegato trasmettiamo ordine di acquisto e documentazione relativa.\\n\\nCordiali saluti.",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Login - salva token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Compila le collection variables email e password. Dopo il login il token viene salvato automaticamente in {{token_admin}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const token = json?.data?.token || json?.token;",
                  "",
                  "if (token) {",
                  "  pm.collectionVariables.set('token_admin', token);",
                  "  console.log('Token salvato nelle collection variables');",
                  "} else {",
                  "  console.warn('Token non trovato nella risposta. Controlla il formato della response.');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me - verifica token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Verifica che il token salvato sia valido."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Me OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Ordini acquisto",
      "item": [
        {
          "name": "Lista ordini acquisto - imposta primo ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/ordini-acquisto",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "ordini-acquisto"
              ]
            },
            "description": "Recupera gli ordini acquisto. Se trova almeno un ordine, salva automaticamente il primo id in {{ordine_acquisto_id}}."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Lista ordini OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const rows = Array.isArray(json?.data) ? json.data : [];",
                  "",
                  "if (rows.length > 0 && rows[0].id) {",
                  "  pm.collectionVariables.set('ordine_acquisto_id', String(rows[0].id));",
                  "  console.log('ordine_acquisto_id impostato automaticamente:', rows[0].id);",
                  "} else {",
                  "  console.warn('Nessun ordine trovato. Crea un ordine oppure imposta ordine_acquisto_id manualmente.');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Dettaglio ordine acquisto",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/ordini-acquisto/{{ordine_acquisto_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "ordini-acquisto",
                "{{ordine_acquisto_id}}"
