    {
      "name": "Giacenze — 2 test",
      "item": [
        {
          "name": "01 GET /giacenze/:prodotto_id — senza token → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/giacenze/{{prodotto_id}}"
          }
        },
        {
          "name": "02 GET /giacenze/:prodotto_id — inizialmente vuote",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const d = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status success', () => pm.expect(d.status).to.eql('success'));",
                  "pm.test('data è array', () => pm.expect(d.data).to.be.an('array'));",
                  "pm.test('array vuoto (no movimenti ancora)', () => pm.expect(d.data).to.have.lengthOf(0));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/giacenze/{{prodotto_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_resp_mag}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Movimenti Stock — 22 test",
      "item": [
        {
          "name": "01 POST /movimenti-stock — carico acquisto valido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const d = pm.response.json();",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('tipo CARICO_ACQUISTO', () => pm.expect(d.data.tipo).to.eql('CARICO_ACQUISTO'));",
                  "pm.test('quantita = 10', () => pm.expect(Number(d.data.quantita)).to.eql(10));",
                  "pm.collectionVariables.set('movimento_id', d.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/movimenti-stock",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_resp_mag}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"prodotto_id\":{{prodotto_id}},\"ubicazione_id\":{{ubicazione_a_id}},\"quantita\":10,\"movimento_tipo\":\"CARICO_ACQUISTO\",\"riferimento\":\"{{riferimento_carico}}\",\"note\":\"Carico iniziale M07\"}"
            }
          }
        },
        {
          "name": "02 GET /movimenti-stock/:id — dettaglio movimento",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const d = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('id coerente', () => pm.expect(d.data.id).to.eql(parseInt(pm.collectionVariables.get('movimento_id'))));",
                  "pm.test('riferimento corretto', () => pm.expect(d.data.riferimento).to.eql(pm.collectionVariables.get('riferimento_carico')));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/movimenti-stock/{{movimento_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_resp_mag}}"
              }
            ]
          }
        },
        {
          "name": "03 GET /giacenze/:prodotto_id — dopo carico (A=10)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const d = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('una sola giacenza', () => pm.expect(d.data).to.have.lengthOf(1));",
                  "pm.test('quantita = 10', () => pm.expect(Number(d.data[0].quantita)).to.eql(10));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/giacenze/{{prodotto_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_resp_mag}}"
              }
            ]
          }
        },
