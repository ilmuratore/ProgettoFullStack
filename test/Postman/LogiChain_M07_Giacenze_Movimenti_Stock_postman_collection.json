  "item": [
    {
      "name": "Setup - Autenticazione & Dati M07",
      "description": "Login admin, creazione utenti di test, prodotto, magazzino e due ubicazioni.",
      "item": [
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var run = Date.now().toString();",
                  "pm.collectionVariables.set('runId', run);",
                  "pm.collectionVariables.set('resp_magazzino_email', 'test.m07.rmag.' + run + '@logichain.it');",
                  "pm.collectionVariables.set('operatore_email', 'test.m07.oper.' + run + '@logichain.it');",
                  "pm.collectionVariables.set('prodotto_sku', 'M07-SKU-' + run);",
                  "pm.collectionVariables.set('magazzino_codice', 'MAG-M07-' + run);",
                  "pm.collectionVariables.set('riferimento_carico', 'm07_carico:' + run);",
                  "pm.collectionVariables.set('riferimento_scarico', 'm07_scarico:' + run);",
                  "pm.collectionVariables.set('riferimento_spostamento', 'm07_spostamento:' + run);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var d = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status success', () => pm.expect(d.status).to.eql('success'));",
                  "pm.collectionVariables.set('token_admin', d.data.token);"
                ]
              }
            }
          ]
        },
