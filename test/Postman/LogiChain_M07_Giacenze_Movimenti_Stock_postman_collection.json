    {
      "name": "Giacenze - 2 test",
      "description": "Verifica consultazione giacenze per prodotto.",
      "item": [
        {
          "name": "01 GET /giacenze/:prodotto_id - senza token -> 401",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/giacenze/{{prodotto_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 GET /giacenze/:prodotto_id - inizialmente vuote",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_resp_mag}}"
              }
            ],
            "url": "{{base_url}}/api/v1/giacenze/{{prodotto_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var d = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('data array', () => pm.expect(d.data).to.be.an('array'));",
                  "pm.test('array vuoto', () => pm.expect(d.data).to.have.lengthOf(0));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Movimenti Stock - 14 test",
      "description": "Carico, rettifica, scarico e spostamento con verifica impatto su giacenze.",
      "item": [
        {
          "name": "01 POST /movimenti-stock - carico acquisto valido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_resp_mag}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/movimenti-stock",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prodotto_id\": {{prodotto_id}},\n  \"ubicazione_id\": {{ubicazione_a_id}},\n  \"quantita\": 10,\n  \"movimento_tipo\": \"CARICO_ACQUISTO\",\n  \"riferimento\": \"{{riferimento_carico}}\",\n  \"note\": \"Carico iniziale M07\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var d = pm.response.json();",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('tipo corretto', () => pm.expect(d.data.tipo).to.eql('CARICO_ACQUISTO'));",
                  "pm.test('quantita 10', () => pm.expect(Number(d.data.quantita)).to.eql(10));",
                  "pm.collectionVariables.set('movimento_id', d.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 GET /movimenti-stock/:id - dettaglio movimento",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_resp_mag}}"
              }
            ],
            "url": "{{base_url}}/api/v1/movimenti-stock/{{movimento_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var d = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('id coerente', () => pm.expect(d.data.id).to.eql(parseInt(pm.collectionVariables.get('movimento_id'))));",
                  "pm.test('riferimento corretto', () => pm.expect(d.data.riferimento).to.eql(pm.collectionVariables.get('riferimento_carico')));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 GET /giacenze/:prodotto_id - dopo carico",
