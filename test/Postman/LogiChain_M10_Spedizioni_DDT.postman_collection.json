              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/clienti",
              "host": [
                "{{base_url}}/api/v1/clienti"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ragione_sociale\": \"Cliente {{suffix}}\",\n  \"piva_cf\": \"CF-{{suffix}}\",\n  \"email\": \"cliente.{{suffix}}@test.local\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
