      "item": [
        {
          "id": "339aca7e-674a-4a4b-8763-707b7007882e",
          "name": "01 POST /auth/login — credenziali valide → 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "4e717d63-4c2b-4a5a-a783-43a11666a9b2",
                "exec": [
                  "var b = pm.response.json();",
                  "pm.test('01 login valido -> 200', () => pm.response.to.have.status(200));",
                  "pm.test('01 status = success', () => pm.expect(b.status).to.eql('success'));",
                  "pm.test('01 token e stringa', () => pm.expect(b.data.token).to.be.a('string'));",
                  "pm.test('01 utente presente', () => pm.expect(b.data.utente).to.be.an('object'));",
                  "pm.test('01 utente ha id, email, ruolo', () => {",
                  "  pm.expect(b.data.utente).to.have.property('id');",
                  "  pm.expect(b.data.utente).to.have.property('email');",
                  "  pm.expect(b.data.utente).to.have.property('ruolo');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
