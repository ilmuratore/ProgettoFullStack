                  "var b = pm.response.json();",
                  "pm.test('02 GET /me -> 200', () => pm.response.to.have.status(200));",
                  "pm.test('02 status = success', () => pm.expect(b.status).to.eql('success'));",
                  "pm.test('02 dati utente: id, nome, cognome, email, ruolo', () => {",
