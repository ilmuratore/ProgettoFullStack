      "value": "admin@logichain.it"
    },
    {
      "key": "admin_password",
      "value": "Admin123!"
    },
    {
      "key": "token_admin",
      "value": ""
    },
    {
      "key": "notifica_id",
      "value": ""
    },
    {
      "key": "notifica_non_letta_id",
      "value": ""
    },
    {
      "key": "count_non_lette_before",
      "value": "0"
    },
    {
      "key": "count_non_lette_after_mark_one",
      "value": "0"
    }
  ]
}
