  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "exceljs": "^3.4.0",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "helmet": "8.2.0",
    "jsonwebtoken": "9.0.3",
    "multer": "^2.1.1",
    "node-pg-migrate": "8.0.4",
    "nodemailer": "^8.0.11",
    "nodemon": "3.1.14",
    "pdfkit": "^0.19.1",
    "pg": "8.21.0",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "supertest": "^7.1.4"
  }
}