# -----------------------------------------------------------------------------
# LogiChain ERP Backend - ambiente produzione env
# Copia questo file con:
# cp .env.example .env
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=10000

# Database applicativo di test. Deve essere separato dal DB di sviluppo.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=logichain
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgres://postgres:change_me@localhost:5432/logichain

DB_ADMIN_DATABASE=postgres

JWT_SECRET=test_secret_change_me
JWT_EXPIRES_IN=2h

ADMIN_EMAIL=admin@logichain.it
ADMIN_PASSWORD=Admin123!
ADMIN_NOME=Admin
ADMIN_COGNOME=LogiChain

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=test@example.com
SMTP_PASS=change_me
SMTP_FROM_NAME=LogiChain Test
SMTP_FROM_EMAIL=no-reply@logichain.test
SMTP_REJECT_UNAUTHORIZED=true

CONTABILE_MAX_FILE_SIZE_MB=10
