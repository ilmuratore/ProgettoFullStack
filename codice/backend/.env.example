# -----------------------------------------------------------------------------
# LogiChain ERP Backend - esempio configurazione ambiente
# Copia questo file con:
# cp .env.example .env
# -----------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL - configurazione usata da src/config/db.js
DB_HOST=localhost
DB_PORT=5432
DB_NAME=logichain
DB_USER=postgres
DB_PASSWORD=change_me

# PostgreSQL - usata da node-pg-migrate
DATABASE_URL=postgres://postgres:change_me@localhost:5432/logichain

# JWT
JWT_SECRET=change_me_use_a_long_random_secret
JWT_EXPIRES_IN=1h

# Bootstrap admin - usato da npm run seed_admin
ADMIN_EMAIL=admin@logichain.it
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NOME=Admin
ADMIN_COGNOME=LogiChain

# Email / SMTP - usato per invio documenti acquisto e allegati contabile
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=change_me
SMTP_FROM_NAME=LogiChain ERP
SMTP_FROM_EMAIL=no-reply@logichain.it
SMTP_REJECT_UNAUTHORIZED=true

# Upload contabile acquisti
CONTABILE_MAX_FILE_SIZE_MB=10
