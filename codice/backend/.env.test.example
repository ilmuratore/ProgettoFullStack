# -----------------------------------------------------------------------------
# LogiChain ERP Backend - ambiente test automatici
# Copia questo file con:
# cp .env.test.example .env.test
# -----------------------------------------------------------------------------

NODE_ENV=test
PORT=3001
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=10000

# Database applicativo di test. Deve essere separato dal DB di sviluppo.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=logichain_test
DB_USER=postgres
DB_PASSWORD=change_me
# DATABASE_URL viene rigenerato automaticamente da scripts/loadTestEnv.js durante i test.
# Puoi lasciarlo commentato per evitare mismatch con DB_PASSWORD.
# DATABASE_URL=postgres://postgres:change_me@localhost:5432/logichain_test

# Database amministrativo usato da scripts/resetTestDb.js per creare logichain_test se manca.
DB_ADMIN_DATABASE=postgres

JWT_SECRET=test_secret_change_me
JWT_EXPIRES_IN=2h

ADMIN_EMAIL=admin@logichain.it
ADMIN_PASSWORD=Admin123!
ADMIN_NOME=Admin
ADMIN_COGNOME=LogiChain

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=test@example.com
SMTP_PASS=change_me
SMTP_FROM_NAME=LogiChain Test
SMTP_FROM_EMAIL=no-reply@logichain.test
SMTP_REJECT_UNAUTHORIZED=true

CONTABILE_MAX_FILE_SIZE_MB=10
