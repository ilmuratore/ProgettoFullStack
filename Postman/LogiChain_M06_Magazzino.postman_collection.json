          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET", "url": "{{base_url}}/api/v1/magazzini/{{magazzino_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }]
          }
        },
        {
          "name": "06 GET /magazzini/:id — id inesistente → 404",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
