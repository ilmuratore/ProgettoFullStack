{
  "info": {
    "name": "LogiChain M06 — Magazzino & Ubicazioni",
    "_postman_id": "logichain-m06-magazzino",
    "description": "Test suite per M06: Gestione Magazzino (Magazzini + Ubicazioni).\n\nSetup richiesto:\n- {{base_url}} = http://localhost:3000\n- {{token_admin}}, {{token_resp_magazzino}}, {{token_no_access}} valorizzati dalla folder Setup\n\nEseguire le folder nell'ordine: Setup → Magazzini → Ubicazioni",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",           "value": "http://localhost:3000" },
    { "key": "token_admin",        "value": "" },
    { "key": "token_resp_mag",     "value": "" },
    { "key": "token_no_access",    "value": "" },
    { "key": "magazzino_id",       "value": "" },
    { "key": "ubicazione_id",      "value": "" }
  ],
  "item": [
    {
      "name": "Setup — Autenticazione",
      "item": [
        {
          "name": "Login Admin",
          "event": [{ "listen": "test", "script": { "exec": [
            "const d = pm.response.json();",
            "pm.test('Login admin OK', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('token_admin', d.data.token);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST", "url": "{{base_url}}/api/v1/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"admin@logichain.it\",\"password\":\"Admin1234!\"}" }
          }
        },
        {
          "name": "Login Responsabile Magazzino",
          "event": [{ "listen": "test", "script": { "exec": [
            "const d = pm.response.json();",
            "pm.test('Login resp. magazzino OK', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('token_resp_mag', d.data.token);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST", "url": "{{base_url}}/api/v1/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"resp.magazzino@logichain.it\",\"password\":\"Magazzino1234!\"}" }
          }
        },
        {
          "name": "Login Operatore (no magazzino:write)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const d = pm.response.json();",
            "pm.test('Login operatore OK', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('token_no_access', d.data.token);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST", "url": "{{base_url}}/api/v1/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"operatore@logichain.it\",\"password\":\"Operatore1234!\"}" }
          }
        }
      ]
    },
    {
      "name": "Magazzini — 13 test",
      "item": [
        {
          "name": "01 GET /magazzini — lista (inclusi disattivi)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const d = pm.response.json();",
            "pm.test('status success', () => pm.expect(d.status).to.eql('success'));",
            "pm.test('data è array', () => pm.expect(d.data).to.be.an('array'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET", "url": "{{base_url}}/api/v1/magazzini",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }]
          }
        },
        {
          "name": "02 POST /magazzini — crea magazzino valido",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const d = pm.response.json();",
            "pm.test('status success', () => pm.expect(d.status).to.eql('success'));",
            "pm.test('codice corretto', () => pm.expect(d.data.codice).to.eql('MAG-TEST'));",
            "pm.test('attivo true', () => pm.expect(d.data.attivo).to.be.true);",
            "pm.collectionVariables.set('magazzino_id', d.data.id);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST", "url": "{{base_url}}/api/v1/magazzini",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"codice\":\"MAG-TEST\",\"nome\":\"Magazzino Test\",\"indirizzo\":\"Via Test 1, Milano\"}" }
          }
        },
        {
          "name": "03 POST /magazzini — codice duplicato → 409",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
