            "pm.test('DUPLICATE_ENTRY', () => pm.expect(d.code).to.eql('DUPLICATE_ENTRY'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST", "url": "{{base_url}}/api/v1/magazzini",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"codice\":\"MAG-TEST\",\"nome\":\"Altro Magazzino\"}" }
          }
        },
        {
          "name": "04 POST /magazzini — campo obbligatorio mancante → 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
            "const d = pm.response.json();",
            "pm.test('VALIDATION_ERROR', () => pm.expect(d.code).to.eql('VALIDATION_ERROR'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST", "url": "{{base_url}}/api/v1/magazzini",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"codice\":\"MAG-X\"}" }
          }
