          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Campi aggiornati correttamente', () => {",
                  "    const d = pm.response.json().data;",
                  "    pm.expect(d.telefono).to.eql('0612345678');",
                  "    pm.expect(d.email).to.eql('nuovo@beta.it');",
