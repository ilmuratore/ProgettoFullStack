    {
      "name": "📋 M04 — Clienti (Happy Path)",
      "description": "Test principali in ordine logico. Eseguire dall'alto verso il basso.",
      "item": [
        {
          "name": "01 — GET lista clienti",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
            "url": { "raw": "{{base_url}}/api/v1/clienti", "host": ["{{base_url}}"], "path": ["api", "v1", "clienti"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Struttura risposta corretta', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('success');",
                  "    pm.expect(json.data).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Ogni cliente ha il campo source', () => {",
                  "    const json = pm.response.json();",
                  "    if (json.data.length > 0) {",
                  "        json.data.forEach(c => {",
                  "            pm.expect(c).to.have.property('source');",
                  "            pm.expect(['manual', 'ecosystem']).to.include(c.source);",
                  "        });",
                  "    }",
                  "});",
                  "",
                  "pm.test('Nessun cliente con attivo=false nella lista', () => {",
                  "    const json = pm.response.json();",
                  "    json.data.forEach(c => {",
                  "        pm.expect(c.attivo).to.not.eql(false);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02 — POST crea cliente manual ✅",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ragione_sociale\": \"Beta Spa\",\n  \"piva_cf\": \"98765432101\",\n  \"email\": \"info@beta.it\",\n  \"telefono\": \"0298765432\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/clienti", "host": ["{{base_url}}"], "path": ["api", "v1", "clienti"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "pm.test('Struttura risposta corretta', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('success');",
                  "    pm.expect(json.data).to.be.an('object');",
                  "});",
                  "",
                  "pm.test('source è manual (mai dal body)', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.source).to.eql('manual');",
                  "});",
                  "",
                  "pm.test('Campi obbligatori presenti', () => {",
                  "    const d = pm.response.json().data;",
                  "    pm.expect(d).to.have.property('id');",
                  "    pm.expect(d).to.have.property('ragione_sociale');",
                  "    pm.expect(d).to.have.property('piva_cf');",
                  "});",
                  "",
                  "// Salva id per i test successivi",
                  "const id = pm.response.json().data?.id;",
                  "if (id) {",
                  "    pm.collectionVariables.set('cliente_id', id);",
                  "    console.log('✅ cliente_id salvato:', id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03 — POST source nel body ignorato",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ragione_sociale\": \"Gamma Srl\",\n  \"piva_cf\": \"11122233344\",\n  \"source\": \"ecosystem\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/clienti", "host": ["{{base_url}}"], "path": ["api", "v1", "clienti"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "pm.test('source è manual anche se il body inviava ecosystem', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.source).to.eql('manual');",
                  "});",
                  "",
                  "// Pulizia: il cliente Gamma Srl va soft-deleted dopo i test",
                  "const id = pm.response.json().data?.id;",
                  "if (id) {",
                  "    pm.collectionVariables.set('cliente_gamma_id', id);",
                  "    console.log('ℹ️  cliente_gamma_id salvato per pulizia:', id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "04 — POST campo obbligatorio mancante → 400",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ragione_sociale\": \"Solo Nome Srl\"\n}"
