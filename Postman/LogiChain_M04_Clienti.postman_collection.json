                  "pm.test('Codice VALIDATION_ERROR', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('error');",
                  "    pm.expect(json.code).to.eql('VALIDATION_ERROR');",
                  "});",
                  "",
                  "pm.test('Errore su piva_cf', () => {",
                  "    const json = pm.response.json();",
