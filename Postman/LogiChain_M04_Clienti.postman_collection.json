                  "    pm.expect(fields).to.include('piva_cf');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "05 — GET dettaglio cliente manual",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
            "url": { "raw": "{{base_url}}/api/v1/clienti/{{cliente_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "clienti", "{{cliente_id}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Risposta con dati cliente', () => {",
                  "    const d = pm.response.json().data;",
                  "    pm.expect(d.id.toString()).to.eql(pm.collectionVariables.get('cliente_id').toString());",
                  "    pm.expect(d).to.have.property('ragione_sociale');",
                  "    pm.expect(d).to.have.property('piva_cf');",
                  "    pm.expect(d).to.have.property('source');",
                  "    pm.expect(d.source).to.eql('manual');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "06 — GET id inesistente → 404",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
