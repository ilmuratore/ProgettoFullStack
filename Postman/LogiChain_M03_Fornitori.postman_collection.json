              ],
              "path": [
                "api",
                "v1",
                "fornitori"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('data è un array', () => pm.expect(d).to.be.an('array'));",
                  "pm.test(\"ogni fornitore espone 'source'\", () => d.forEach(f => pm.expect(f).to.have.property('source')));"
                ]
              }
            }
          ]
        },
